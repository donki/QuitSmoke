<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuitSmoke.Pages.AboutPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <!-- 1. Cabecera -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="30,25" Spacing="12">
                    <Image Source="app_logo.png"
                           HeightRequest="96"
                           WidthRequest="96"
                           HorizontalOptions="Center" />

                    <Label Text="QuitSmoke"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center" />

                    <Label x:Name="VersionLabel"
                           Style="{StaticResource HintText}"
                           FontSize="15"
                           HorizontalOptions="Center" />

                    <Label x:Name="DescriptionLabel"
                           Text=""
                           Style="{StaticResource BodyText}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Socratic"
                           Style="{StaticResource HintText}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- 2. Contacto -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="25,20" Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_mail.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" VerticalOptions="Center"
                               x:Name="ContactTitleLabel"
                               Style="{StaticResource CardTitle}" />
                    </Grid>

                    <Button Text="jsoladelarosa@gmail.com"
                            Style="{StaticResource OutlineButton}"
                            FontSize="13"
                            Padding="8,0"
                            Clicked="OnContactEmailClicked"
                            HorizontalOptions="Fill" />

                    <Label x:Name="ContactHintLabel"
                           Text=""
                           Style="{StaticResource HintText}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- 4. Idioma -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="25,20" Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_language.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" VerticalOptions="Center"
                               x:Name="LanguageTitleLabel"
                               Style="{StaticResource CardTitle}" />
                    </Grid>

                    <!-- Una fila por idioma: con la letra grande, bandera y nombre no caben en media tarjeta -->
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                        <Button x:Name="SpanishButton"
                                ImageSource="ic_flag_es.png"
                                ContentLayout="Left,8"
                                Grid.Row="0"
                                Style="{StaticResource OutlineButton}"
                                Clicked="OnSpanishClicked" />

                        <Button x:Name="EnglishButton"
                                ImageSource="ic_flag_us.png"
                                ContentLayout="Left,8"
                                Grid.Row="1"
                                Style="{StaticResource OutlineButton}"
                                Clicked="OnEnglishClicked" />
                    </Grid>

                    <Label x:Name="LanguageHintLabel"
                           Text=""
                           Style="{StaticResource HintText}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- 5. Privacidad -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="25,20" Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_lock.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" VerticalOptions="Center"
                               x:Name="PrivacyTitleLabel"
                               Style="{StaticResource CardTitle}" />
                    </Grid>

                    <Label x:Name="PrivacyTextLabel"
                           Text=""
                           Style="{StaticResource BodyText}"
                           LineHeight="1.4" />
                </VerticalStackLayout>
            </Border>

            <!-- 6. Licencia -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="25,20" Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_license.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" VerticalOptions="Center"
                               x:Name="LicenseTitleLabel"
                               Style="{StaticResource CardTitle}" />
                    </Grid>

                    <Label x:Name="LicenseTextLabel"
                           Text=""
                           Style="{StaticResource BodyText}"
                           LineHeight="1.4" />

                    <Label x:Name="LicenseLineLabel"
                           Text=""
                           Style="{StaticResource HintText}" />
                </VerticalStackLayout>
            </Border>

            <!-- 7. Aviso Legal -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="25,20" Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_legal_danger.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" VerticalOptions="Center"
                               x:Name="LegalTitleLabel"
                               Style="{StaticResource CardTitle}"
                               TextColor="{StaticResource Danger}" />
                    </Grid>

                    <Label x:Name="LegalText1Label"
                           Text=""
                           Style="{StaticResource BodyText}"
                           LineHeight="1.4" />

                    <Label x:Name="LegalText2Label"
                           Text=""
                           Style="{StaticResource BodyText}"
                           LineHeight="1.4" />

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource DangerSurfaceLight}, Dark={StaticResource DangerSurfaceDark}}"
                            Stroke="{StaticResource Danger}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HorizontalOptions="Center">
                            <Image Source="ic_warning_danger.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label x:Name="LegalWarningLabel"
                                   Grid.Column="1"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Danger}"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
