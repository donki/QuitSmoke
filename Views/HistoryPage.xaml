<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="QuitSmoke.Views.HistoryPage"
             Title="{Binding Title}"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid>
        <!-- Spinner de carga -->
        <VerticalStackLayout x:Name="LoadingView" IsVisible="{Binding IsLoading}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="16">
            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="{Binding IsLoading}"
                               HeightRequest="50"
                               WidthRequest="50" />
            <Label x:Name="LoadingLabel" Text="{Binding LoadingText}"
                   Style="{StaticResource HintText}"
                   FontSize="16"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Contenido principal -->
        <ScrollView x:Name="ContentView" IsVisible="{Binding IsLoaded}">
            <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Estadísticas principales -->
            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="16">
                    <Label x:Name="GeneralStatsLabel" Text="{Binding GeneralStats}"
                           Style="{StaticResource CardTitle}"
                           HorizontalOptions="Center" />

                    <!-- Grid de estadísticas -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="12">

                        <!-- Total cigarros -->
                        <Border Grid.Row="0" Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 10"
                                Padding="12">
                            <VerticalStackLayout Spacing="4">
                                <Image Source="ic_cigarette.png" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" />
                                <Label x:Name="TotalCigarettesLabel" Text="{Binding TotalCigarettes}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center" />
                                <Label x:Name="TotalCigarettesCaption" Text="{Binding TotalCigarettesCaption}"
                                       Style="{StaticResource HintText}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Días registrados -->
                        <Border Grid.Row="0" Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                                Stroke="{StaticResource Success}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 10"
                                Padding="12">
                            <VerticalStackLayout Spacing="4">
                                <Image Source="ic_calendar.png" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" />
                                <Label x:Name="TotalDaysLabel" Text="{Binding TotalDays}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Success}"
                                       HorizontalOptions="Center" />
                                <Label x:Name="DaysRecordedCaption" Text="{Binding DaysRecordedCaption}"
                                       Style="{StaticResource HintText}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Promedio por día -->
                        <Border Grid.Row="1" Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                                Stroke="{StaticResource Accent}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 10"
                                Padding="12">
                            <VerticalStackLayout Spacing="4">
                                <Image Source="ic_chart_bar.png" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" />
                                <Label x:Name="AveragePerDayLabel" Text="{Binding AveragePerDay}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Accent}"
                                       HorizontalOptions="Center" />
                                <Label x:Name="AvgPerDayCaption" Text="{Binding AvgPerDayCaption}"
                                       Style="{StaticResource HintText}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Reducción lograda -->
                        <Border Grid.Row="1" Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                                Stroke="{StaticResource Success}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 10"
                                Padding="12">
                            <VerticalStackLayout Spacing="4">
                                <Image Source="ic_trending_down.png" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" />
                                <Label x:Name="ReductionLabel" Text="{Binding Reduction}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Success}"
                                       HorizontalOptions="Center" />
                                <Label x:Name="ReductionCaption" Text="{Binding ReductionCaption}"
                                       Style="{StaticResource HintText}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Resumen textual -->
                        <Border Grid.Row="2" Grid.ColumnSpan="2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource SeparatorLight}, Dark={StaticResource SeparatorDark}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="12">
                            <Label x:Name="SummaryLabel" Text="{Binding Summary}"
                                   Style="{StaticResource BodyText}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Estadísticas económicas -->
            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="16">
                    <Label x:Name="EconomicStatsLabel" Text="{Binding EconomicStats}"
                           Style="{StaticResource CardTitle}"
                           HorizontalOptions="Center" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <!-- Total gastado -->
                        <Border Grid.Row="0" Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                                Stroke="{StaticResource Danger}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 10"
                                Padding="12">
                            <VerticalStackLayout Spacing="4">
                                <Image Source="ic_money.png" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" />
                                <Label x:Name="TotalSpentLabel" Text="{Binding TotalSpent}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Danger}"
                                       HorizontalOptions="Center" />
                                <Label x:Name="TotalSpentCaption" Text="{Binding TotalSpentCaption}"
                                       Style="{StaticResource HintText}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Total ahorrado -->
                        <Border Grid.Row="0" Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                                Stroke="{StaticResource Success}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 10"
                                Padding="12">
                            <VerticalStackLayout Spacing="4">
                                <Image Source="ic_piggy.png" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" />
                                <Label x:Name="TotalSavedLabel" Text="{Binding TotalSaved}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Success}"
                                       HorizontalOptions="Center" />
                                <Label x:Name="TotalSavedCaption" Text="{Binding TotalSavedCaption}"
                                       Style="{StaticResource HintText}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Gasto promedio por día -->
                        <Border Grid.Row="1" Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                                Stroke="{StaticResource Accent}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 10"
                                Padding="12">
                            <VerticalStackLayout Spacing="4">
                                <Image Source="ic_chart_bar.png" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" />
                                <Label x:Name="AverageSpentLabel" Text="{Binding AverageSpent}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Accent}"
                                       HorizontalOptions="Center" />
                                <Label x:Name="AvgSpentCaption" Text="{Binding AvgPerDayCaption}"
                                       Style="{StaticResource HintText}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Porcentaje de ahorro -->
                        <Border Grid.Row="1" Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 10"
                                Padding="12">
                            <VerticalStackLayout Spacing="4">
                                <Image Source="ic_percent.png" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" />
                                <Label x:Name="SavingsPercentageLabel" Text="{Binding SavingsPercentage}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center" />
                                <Label x:Name="SavingsPctCaption" Text="{Binding SavingsPctCaption}"
                                       Style="{StaticResource HintText}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Botón actualizar -->
            <Button x:Name="RefreshButton" Text="{Binding RefreshText}"
                    ImageSource="ic_refresh_w.png"
                    ContentLayout="Left,8"
                    Clicked="OnRefreshClicked"
                    Style="{StaticResource PrimaryButton}"
                    FontSize="16"
                    CornerRadius="25"
                    HeightRequest="50" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
