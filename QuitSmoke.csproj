<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>QuitSmoke</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Hot Reload Configuration -->
    <UseInterpreter Condition="'$(Configuration)' == 'Debug'">True</UseInterpreter>
    <PublishTrimmed>false</PublishTrimmed>
    <MauiEnableVisualStudioHotReload>true</MauiEnableVisualStudioHotReload>

    <!-- Display Version (Constitucion §6: DisplayVersion legible + Version entero incremental, en sincronia) -->
    <ApplicationDisplayVersion>2026.07.31.0</ApplicationDisplayVersion>
    <ApplicationVersion>202607310</ApplicationVersion>

    <!-- Company Information -->
    <Company>sOCratic</Company>
    <Authors>sOCratic</Authors>
    <Product>QuitSmoke</Product>
    <Copyright>Copyright © sOCratic 2025</Copyright>

    <!-- Android -->
    <ApplicationId>com.socratic.quitsmoke</ApplicationId>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <TargetSdkVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">36</TargetSdkVersion>
    <UseDefaultAndroidSdkDirectory>true</UseDefaultAndroidSdkDirectory>
    <AndroidSdkDirectory>C:\Program Files (x86)\Android\android-sdk</AndroidSdkDirectory>
    <AndroidPackageFormat Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">apk</AndroidPackageFormat>
    <AndroidUseAapt2 Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">True</AndroidUseAapt2>
    <AndroidCreatePackagePerAbi Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">False</AndroidCreatePackagePerAbi>

    <AssemblyVersion>1.0.0.88</AssemblyVersion>
    <FileVersion>1.0.0.88</FileVersion>
  </PropertyGroup>

  <!--
    Embeber los ensamblados en el APK también en Debug. Sin esto, un APK Debug usa Fast Deployment:
    los ensamblados no viajan dentro del APK y la app aborta al arrancar ("No assemblies found")
    cuando se instala suelta con adb (sin desplegar desde el IDE).
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#3525CD" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#3525CD" BaseSize="200,200" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

    <!-- Tipografia del sistema (A.9): no se embeben fuentes propias. -->

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
    <PackageReference Include="Plugin.LocalNotification" Version="11.1.0" />
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="Views\HistoryPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>



  <!-- Notas de autor compartidas (una sola fuente para todas las apps) -->
  <ItemGroup>
    <Compile Include="..\Shared\AuthorNotes.cs" Link="AuthorNotes.cs" />
    <Compile Include="..\Shared\ModernDialog.cs" Link="ModernDialog.cs" />
  </ItemGroup>

  <Import Project="..\Shared\signing.props" />
</Project>